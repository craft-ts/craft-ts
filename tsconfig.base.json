{
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "target": "es2022",
    "module": "esnext",
    "lib": ["es2022", "dom", "dom.iterable"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "erasableSyntaxOnly": true,
    "experimentalDecorators": false,
    "emitDecoratorMetadata": false,
    "customConditions": ["@craft-ts/source"],
    // A relative import may carry its `.ts` extension, and is rewritten to
    // `.js` on emit. Permissive, not prescriptive: extensionless imports keep
    // working everywhere. It exists because code Node loads directly — a Vite
    // plugin, in this workspace and once published — needs real specifiers.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "paths": {
      "@craft-ts/core": ["./libs/core/src/index.ts"],
      "@craft-ts/i18n": ["./libs/i18n/src/index.ts"],
      "@craft-ts/i18n-effect": ["./libs/i18n-effect/src/index.ts"],
      "@craft-ts/core/dev-tools": ["./libs/core/src/lib/dev-tools.ts"],
      "@craft-ts/component": ["./libs/component/src/index.ts"],
      "@craft-ts/style": ["./libs/style/src/index.ts"],
      "@craft-ts/style/vite": ["./libs/style/src/plugin/vite.ts"],
      "@craft-ts/style-testing": ["./libs/style-testing/src/index.ts"],
      "@craft-ts/component/testing": ["./libs/component/testing/public-api.ts"],
      "test-type": ["./libs/test-type/src/index.ts"],
      "@craft-ts/dev-tools": ["./libs/dev-tools/src/index.ts"],
      "@craft-ts/dev-tools/*": ["./libs/dev-tools/src/*"],
      "@craft-ts/dev-tools/testing": ["./libs/dev-tools/src/testing.ts"],
      "@craft-ts/dev-tools/template-migration": [
        "./libs/dev-tools/src/template-migration.ts"
      ],
      "@craft-ts/effect": ["./libs/effect/src/index.ts"],
      "@craft-ts/deploy": ["./libs/deploy/src/index.ts"],
      "@craft-ts/cli": ["./libs/cli/src/index.ts"],
      "@craft-ts/deploy-alchemy": ["./libs/deploy-alchemy/src/index.ts"]
    }
  }
}
