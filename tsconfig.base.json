{
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "customConditions": ["@ng-craft/source"],
    "paths": {
      "@craft-ng/core": ["libs/core/src/index.ts"],
      "@craft-ng/angular": ["libs/angular/src/index.ts"],
      "@craft-ng/component": ["libs/component/src/index.ts"],
      "@craft-ng/component/testing": ["libs/component/testing/public-api.ts"],
      "test-type": ["libs/test-type/src/index.ts"],
      "@craft-ng/dev-tools": ["libs/dev-tools/src/index.ts"],
      "@craft-ng/dev-tools/testing": ["libs/dev-tools/src/testing.ts"],
      "@craft-ng/dev-tools/template-migration": [
        "libs/dev-tools/src/template-migration.ts"
      ]
    }
  }
}
