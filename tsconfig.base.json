{
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "target": "es2022",
    "module": "esnext",
    "lib": [
      "es2022",
      "dom",
      "dom.iterable"
    ],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "erasableSyntaxOnly": true,
    "experimentalDecorators": false,
    "emitDecoratorMetadata": false,
    "customConditions": [
      "@ng-craft/source"
    ],
    "paths": {
      "@craft-ng/core": [
        "./libs/core/src/index.ts"
      ],
      "@craft-ng/component": [
        "./libs/component/src/index.ts"
      ],
      "@craft-ng/component/testing": [
        "./libs/component/testing/public-api.ts"
      ],
      "test-type": [
        "./libs/test-type/src/index.ts"
      ],
      "@craft-ng/dev-tools": [
        "./libs/dev-tools/src/index.ts"
      ],
      "@craft-ng/dev-tools/testing": [
        "./libs/dev-tools/src/testing.ts"
      ],
      "@craft-ng/dev-tools/template-migration": [
        "./libs/dev-tools/src/template-migration.ts"
      ]
    }
  }
}
