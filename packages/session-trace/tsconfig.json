{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // Pure module shared by the browser dashboard and Node tools: no DOM, no
    // Node types. `TextEncoder` is the only host global and is declared below.
    "lib": ["ES2022"],
    "types": [],
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "sourceMap": true,
    "noEmit": false,
    "strict": true,
    "isolatedModules": true,
    "customConditions": [],
    "paths": {},
    "importHelpers": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.spec.ts"]
}
