{
  "name": "@craft-ts/session-trace",
  "version": "0.9.3",
  "description": "Normalize and compare CraftTS debug sessions as deterministic traces",
  "author": "Romain Geffrault",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "!dist/**/*.spec.js",
    "!dist/**/*.spec.d.ts",
    "!dist/**/*.spec.js.map"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --config vitest.config.mts"
  },
  "devDependencies": {
    "@types/node": "20.19.9",
    "typescript": "6.0.3",
    "vitest": "^4.0.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
