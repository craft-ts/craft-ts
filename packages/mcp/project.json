{
  "name": "mcp",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/mcp/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist", "{projectRoot}/content/docs-index.json"],
      "options": {
        "command": "npm run build --workspace @craft-ng/mcp"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm test --workspace @craft-ng/mcp"
      }
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "{projectRoot}"
      }
    }
  }
}
