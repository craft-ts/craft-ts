{
  "name": "@craft-ts/source",
  "version": "0.0.0",
  "license": "MIT",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "typecheck": "tsc -b tsconfig.json --pretty false",
    "start": "nx serve demo-with-server-function",
    "effect:check": "nx run-many -t effect-check --projects demo-effect,quickstart-effect,demo-with-server-function --output-style=stream",
    "graph:update": "node tools/update-graph.mjs",
    "registry:mcp": "npm run start --workspace @craft-ts/function-registry-mcp",
    "logs:server": "npm run start --workspace @craft-ts/log-server",
    "logs:mcp": "npm run start --workspace @craft-ts/log-mcp",
    "craft:mcp": "npm run start --workspace @craft-ts/mcp",
    "release:check": "node --test tools/release.test.mjs tools/release-local.test.mjs",
    "release:local": "node tools/release-local.mjs"
  },
  "private": true,
  "devDependencies": {
    "@effect/tsgo": "^0.24.3",
    "@effect/platform-node": "^4.0.0-rc.110",
    "@eslint/js": "^9.8.0",
    "@nx/devkit": "23.1.1",
    "@nx/eslint": "23.1.1",
    "@nx/eslint-plugin": "23.1.1",
    "@nx/js": "23.1.1",
    "@nx/playwright": "23.1.1",
    "@nx/vite": "23.1.1",
    "@nx/vitest": "23.1.1",
    "@nx/web": "23.1.1",
    "@playwright/test": "^1.36.0",
    "@swc-node/register": "^1.11.1",
    "@swc/core": "^1.15.8",
    "@swc/helpers": "~0.5.11",
    "@types/node": "20.19.9",
    "@typescript-eslint/utils": "^8.67.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "aria-query": "^5.3.2",
    "autoprefixer": "^10.4.0",
    "effect": "^4.0.0-rc.110",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-playwright": "^1.6.2",
    "jsdom": "^27.1.0",
    "jsonc-eslint-parser": "^2.1.0",
    "nx": "23.1.1",
    "postcss": "^8.4.5",
    "postcss-url": "~10.1.3",
    "prettier": "~3.6.2",
    "redis": "^6.2.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.67.0",
    "verdaccio": "^6.0.5",
    "vite": "^8.2.2",
    "vitepress": "^1.6.4",
    "vitepress-plugin-llms": "^1.13.5",
    "vitest": "^4.1.11"
  },
  "workspaces": [
    "apps/log-server",
    "packages/*",
    "libs/test-type",
    "tools/generators"
  ],
  "dependencies": {
    "alien-signals": "^3.2.1",
    "elkjs": "^0.12.0",
    "ts-morph": "^24.0.0"
  },
  "nx": {
    "includedScripts": [],
    "targets": {
      "local-registry": {
        "executor": "@nx/js:verdaccio",
        "options": {
          "port": 4873,
          "config": ".verdaccio/config.yml",
          "storage": "tmp/local-registry/storage"
        }
      }
    }
  }
}
