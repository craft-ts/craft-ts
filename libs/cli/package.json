{
  "name": "@craft-ts/cli",
  "version": "0.8.4",
  "description": "CraftTS deployment CLI: check a deployment manifest and resolve it to its artefact form",
  "author": "Romain Geffrault",
  "license": "MIT",
  "homepage": "https://craft-ts.github.io/craft/",
  "bugs": {
    "url": "https://github.com/craft-ts/craft-ts/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/craft-ts/craft-ts.git"
  },
  "keywords": [
    "craft-ts",
    "cli",
    "deployment",
    "manifest",
    "typescript"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "bin": {
    "craft-ts": "./src/bin/craft-ts.js"
  },
  "dependencies": {
    "@craft-ts/attest": "^0.8.3",
    "@craft-ts/deploy": "^0.8.4"
  },
  "peerDependencies": {
    "@craft-ts/dev-tools": "^0.8.4",
    "@craft-ts/style-testing": "^0.8.4",
    "typescript": ">=5.4.0"
  },
  "peerDependenciesMeta": {
    "@craft-ts/dev-tools": {
      "optional": true
    },
    "@craft-ts/style-testing": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  }
}
