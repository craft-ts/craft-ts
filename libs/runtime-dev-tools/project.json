{
  "name": "ng-craft-runtime-dev-tools",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/runtime-dev-tools/src",
  "prefix": "lib",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "libs/runtime-dev-tools/ng-package.json",
        "tsConfig": "libs/runtime-dev-tools/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/runtime-dev-tools/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "defaultConfiguration": "production"
    },
    "test": {
      "executor": "@nx/angular:unit-test",
      "options": {
        "runner": "vitest"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
