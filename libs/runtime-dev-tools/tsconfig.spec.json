{
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "types": ["vitest/globals"],
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom"],
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "customConditions": ["@ng-craft/source"],
    "paths": {
      "@craft-ng/core": ["../../libs/core/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts"]
}
