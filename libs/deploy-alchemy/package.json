{
  "name": "@craft-ts/deploy-alchemy",
  "version": "0.8.1",
  "description": "Optional Alchemy provider for CraftTS deployments: Cloudflare and AWS presets driven by the deployment manifest",
  "author": "Romain Geffrault",
  "license": "MIT",
  "homepage": "https://craft-ts.github.io/craft/",
  "bugs": {
    "url": "https://github.com/craft-ts/craft-ts/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/craft-ts/craft-ts.git"
  },
  "keywords": [
    "craft-ts",
    "deployment",
    "alchemy",
    "cloudflare",
    "aws",
    "infrastructure",
    "typescript"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "dependencies": {
    "@craft-ts/deploy": "^0.8.1"
  },
  "peerDependencies": {
    "alchemy": ">=2.0.0-beta.76",
    "effect": ">=4.0.0-rc.112 || >=4.0.0"
  },
  "peerDependenciesMeta": {
    "alchemy": {
      "optional": true
    }
  }
}
