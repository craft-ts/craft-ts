{
  "compilerOptions": {
    // No `outDir`: it makes tsc infer a rootDir for this project, and every
    // file reached through the path mappings below then reports TS6059.
    "noEmit": true,
    "types": ["vitest/globals", "node"],
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom"],
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "customConditions": ["@craft-ts/source"],
    "paths": {
      "@craft-ts/core": ["../../libs/core/src/index.ts"],
      "test-type": ["../../libs/test-type/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts"]
}
