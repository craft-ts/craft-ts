{
  "name": "ng-craft-component",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/component/src",
  "prefix": "craft",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "libs/component/ng-package.json",
        "tsConfig": "libs/component/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/component/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "defaultConfiguration": "production"
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/run-lib-vitest.mjs libs/component/vitest.config.ts",
        "forwardAllArgs": true
      }
    },
    "test-angular": {
      "executor": "@nx/angular:unit-test",
      "options": {
        "runner": "vitest"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "maxWarnings": -1
      }
    }
  }
}
