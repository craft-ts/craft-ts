{
  "name": "craft-ts-stream",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/stream/src",
  "prefix": "craft",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/stream",
        "main": "libs/stream/src/index.ts",
        "tsConfig": "libs/stream/tsconfig.lib.prod.json",
        "assets": ["libs/stream/LICENSE"]
      }
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/run-lib-vitest.mjs libs/stream/vitest.config.ts",
        "forwardAllArgs": true
      }
    },
    "typecheck-spec": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p libs/stream/tsconfig.spec.json --noEmit --pretty false"
      },
      "inputs": [
        "{workspaceRoot}/tsconfig.base.json",
        "{projectRoot}/tsconfig.spec.json",
        "{projectRoot}/src/**/*.ts"
      ],
      "cache": true
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "maxWarnings": -1
      }
    }
  }
}
