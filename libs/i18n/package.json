{
  "name": "@craft-ts/i18n",
  "version": "0.7.0-beta.20",
  "description": "Type-safe internationalisation integrated with CraftTS",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
