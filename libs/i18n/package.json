      "default": "./src/testing.js"
    }
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@craft-ts/core": "^0.7.0-beta.0"
  },
  "sideEffects": false
}
