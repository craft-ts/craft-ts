{
  "name": "demo-ssr",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/demo-ssr/src",
  "targets": {
    "serve": {
      "continuous": true,
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "npx vite --config apps/demo-ssr/vite.config.ts",
            "forwardAllArgs": true
          },
          {
            "command": "node tools/demo-typecheck.mjs --project=demo-ssr --config=tsconfig.json --non-blocking",
            "forwardAllArgs": false
          }
        ],
        "parallel": true
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/demo-ssr"],
      "options": {
        "command": "npx vite build --config apps/demo-ssr/vite.config.ts && npx vite build --config apps/demo-ssr/vite.ssr.config.ts"
      },
      "configurations": {
        "production": {
          "command": "npx vite build --config apps/demo-ssr/vite.config.ts --mode production && npx vite build --config apps/demo-ssr/vite.ssr.config.ts --mode production"
        },
        "development": {
          "command": "npx vite build --config apps/demo-ssr/vite.config.ts --mode development && npx vite build --config apps/demo-ssr/vite.ssr.config.ts --mode development"
        }
      },
      "defaultConfiguration": "production"
    },
    "start-production": {
      "continuous": true,
      "executor": "nx:run-commands",
      "options": {
        "command": "node dist/apps/demo-ssr/server/server.js"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/demo-typecheck.mjs --project=demo-ssr --config=tsconfig.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx vitest run --config apps/demo-ssr/vitest.config.ts"
      }
    },
    "architecture": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx vitest run --config vitest.architecture.config.ts",
        "cwd": "apps/demo-ssr"
      },
      "inputs": [
        "{projectRoot}/src/**/*.ts",
        "{projectRoot}/architecture/**/*.ts",
        "{projectRoot}/tsconfig.graph.json",
        "{projectRoot}/tsconfig.architecture.json",
        "{workspaceRoot}/libs/dev-tools/src/**/*.ts"
      ],
      "cache": true
    },
    "typecheck-architecture": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/demo-ssr",
        "command": "tsc -p tsconfig.architecture.json --noEmit --pretty false"
      },
      "inputs": [
        "{projectRoot}/tsconfig.json",
        "{projectRoot}/tsconfig.architecture.json",
        "{projectRoot}/architecture/**/*.ts",
        "{workspaceRoot}/libs/dev-tools/src/**/*.ts"
      ],
      "cache": true
    }
  }
}
