{
  "name": "quickstart-effect",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/quickstart-effect/src",
  "tags": ["scope:quickstart", "type:app"],
  "targets": {
    "build-local-types": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node_modules/.bin/tsc -b libs/core/tsconfig.lib.json libs/effect/tsconfig.lib.json libs/component/tsconfig.lib.json libs/dev-tools/tsconfig.lib.json --pretty false"
      },
      "cache": false
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["build-local-types"],
      "options": {
        "cwd": "apps/quickstart-effect",
        "command": "tsc -p tsconfig.app.json --noEmit --pretty false"
      },
      "inputs": [
        "{workspaceRoot}/tsconfig.base.json",
        "{projectRoot}/tsconfig.json",
        "{projectRoot}/tsconfig.app.json",
        "{projectRoot}/src/**/*.ts",
        "!{projectRoot}/src/**/*.spec.ts",
        "!{projectRoot}/src/**/*.test.ts"
      ],
      "cache": true
    },
    "effect-check": {
      "executor": "nx:run-commands",
      "dependsOn": ["build-local-types"],
      "options": {
        "command": "node tools/run-effect-tsgo.mjs diagnostics --project apps/quickstart-effect/tsconfig.effect.json --format text --severity error,warning,message"
      },
      "inputs": [
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/tsconfig.base.json",
        "{projectRoot}/tsconfig.json",
        "{projectRoot}/tsconfig.effect.json",
        "{projectRoot}/src/**/*.ts"
      ],
      "cache": true
    },
    "typecheck-spec": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/quickstart-effect",
        "command": "tsc -p tsconfig.spec.json --noEmit --pretty false"
      },
      "inputs": [
        "{workspaceRoot}/tsconfig.base.json",
        "{projectRoot}/tsconfig.json",
        "{projectRoot}/tsconfig.spec.json",
        "{projectRoot}/src/**/*.ts"
      ],
      "cache": true
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/quickstart-effect"],
      "options": {
        "command": "npx vite build --config apps/quickstart-effect/vite.config.ts"
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "continuous": true,
      "executor": "nx:run-commands",
      "dependsOn": ["build-local-types"],
      "options": {
        "command": "npx vite --config apps/quickstart-effect/vite.config.ts",
        "forwardAllArgs": true
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/run-lib-vitest.mjs apps/quickstart-effect/vitest.config.ts",
        "forwardAllArgs": true
      }
    },
    "architecture": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx vitest run --config vitest.architecture.config.ts",
        "cwd": "apps/quickstart-effect"
      },
      "inputs": [
        "{projectRoot}/src/**/*.ts",
        "{projectRoot}/architecture/**/*.ts",
        "{projectRoot}/tsconfig.graph.json",
        "{projectRoot}/tsconfig.architecture.json"
      ],
      "cache": true
    },
    "typecheck-architecture": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/quickstart-effect",
        "command": "tsc -p tsconfig.architecture.json --noEmit --pretty false"
      },
      "inputs": [
        "{workspaceRoot}/tsconfig.base.json",
        "{projectRoot}/tsconfig.json",
        "{projectRoot}/tsconfig.architecture.json",
        "{projectRoot}/architecture/**/*.ts"
      ],
      "cache": true
    }
  }
}
