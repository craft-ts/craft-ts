{
  "name": "demo-ecommerce",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/demo-ecommerce/src",
  "targets": {
    "serve": { "continuous": true, "dependsOn": ["resume-check"], "executor": "nx:run-commands", "options": { "command": "npx vite --config apps/demo-ecommerce/vite.config.ts", "forwardAllArgs": true } },
    "build": { "dependsOn": ["resume-check"], "executor": "nx:run-commands", "outputs": ["{workspaceRoot}/dist/apps/demo-ecommerce"], "options": { "command": "npx vite build --config apps/demo-ecommerce/vite.config.ts" }, "configurations": { "production": { "command": "npx vite build --config apps/demo-ecommerce/vite.config.ts --mode production" }, "development": { "command": "npx vite build --config apps/demo-ecommerce/vite.config.ts --mode development" } }, "defaultConfiguration": "production" },
    "resume-check": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/apps/demo-ecommerce/.craft/craft-dependency-graph.json", "{workspaceRoot}/apps/demo-ecommerce/.craft/resume-graph.json"],
      "options": { "command": "npx tsx libs/dev-tools/src/bin/craft-graph.ts --project tsconfig.json --root apps/demo-ecommerce --format json --out .craft/craft-dependency-graph.json --resume-graph .craft/resume-graph.json --check-resume" },
      "inputs": ["{workspaceRoot}/package.json", "{workspaceRoot}/package-lock.json", "{workspaceRoot}/tsconfig.base.json", "{workspaceRoot}/libs/dev-tools/src/bin/craft-graph.ts", "{workspaceRoot}/libs/dev-tools/src/scripts/**/*.ts", "{projectRoot}/tsconfig.json", "{projectRoot}/src/**/*.ts"],
      "cache": true
    },
    "typecheck": { "executor": "nx:run-commands", "options": { "command": "npx tsc -p apps/demo-ecommerce/tsconfig.json --noEmit --pretty false" } },
    "effect-check": { "executor": "nx:run-commands", "options": { "command": "node tools/run-effect-tsgo.mjs diagnostics --project apps/demo-ecommerce/tsconfig.json --format text --severity error,warning,message" }, "inputs": ["{workspaceRoot}/package.json", "{workspaceRoot}/package-lock.json", "{workspaceRoot}/tsconfig.base.json", "{projectRoot}/tsconfig.json", "{projectRoot}/src/**/*.ts"], "cache": true },
    "lint": { "executor": "@nx/eslint:lint", "options": { "lintFilePatterns": ["apps/demo-ecommerce/src/server/**/*.ts", "apps/demo-ecommerce/src/shared/**/*.ts", "apps/demo-ecommerce/src/client/**/*.ts", "apps/demo-ecommerce/e2e/**/*.ts"] } },
    "test": { "executor": "nx:run-commands", "options": { "command": "vitest run --config apps/demo-ecommerce/vitest.config.ts" }, "inputs": ["{projectRoot}/src/**/*.ts", "{projectRoot}/vitest.config.ts"] },
    "architecture": { "executor": "nx:run-commands", "options": { "command": "npx vitest run --config apps/demo-ecommerce/vitest.architecture.config.ts" }, "inputs": ["{projectRoot}/e2e/**/*.ts", "{projectRoot}/architecture/**/*.ts", "{projectRoot}/playwright.config.ts"] },
    "lint-e2e": { "executor": "@nx/eslint:lint", "options": { "lintFilePatterns": ["apps/demo-ecommerce/e2e/**/*.ts"] } },
    "e2e": {
      "executor": "nx:run-commands",
      "dependsOn": ["lint-e2e", "architecture"],
      "cache": false,
      "options": {
        "command": "npx playwright test --config apps/demo-ecommerce/playwright.config.ts"
      }
    },
    "resume-personas": { "executor": "nx:run-commands", "options": { "command": "npx tsx apps/demo-ecommerce/scripts/write-resume-personas.ts" } },
    "e2e-resume": { "executor": "nx:run-commands", "dependsOn": ["resume-check"], "cache": false, "options": { "command": "npx playwright test --config apps/demo-ecommerce/playwright.resume.config.ts" } }
  }
}
