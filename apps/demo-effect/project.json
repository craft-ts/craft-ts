{
  "name": "demo-effect",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/demo-effect/src",
  "tags": [],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["build-local-types"],
      "options": {
        "cwd": "apps/demo-effect",
        "command": "node ../../tools/demo-typecheck.mjs --project=demo-effect"
      },
      "inputs": [
        "{workspaceRoot}/tsconfig.base.json",
        "{projectRoot}/tsconfig.json",
        "{projectRoot}/tsconfig.app.json",
        "{projectRoot}/src/**/*.ts",
        "!{projectRoot}/src/**/*.spec.ts",
        "!{projectRoot}/src/**/*.test.ts"
      ],
      "cache": true
    },
    "effect-check": {
      "executor": "nx:run-commands",
      "dependsOn": ["build-local-types"],
      "options": {
        "command": "node tools/run-effect-tsgo.mjs diagnostics --project apps/demo-effect/tsconfig.effect.json --format text --severity error,warning,message"
      },
      "inputs": [
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/tsconfig.base.json",
        "{projectRoot}/tsconfig.json",
        "{projectRoot}/tsconfig.app.json",
        "{projectRoot}/tsconfig.effect.json",
        "{projectRoot}/src/**/*.ts"
      ],
      "cache": true
    },
    "build-local-types": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node_modules/.bin/tsc -b libs/core/tsconfig.lib.json libs/effect/tsconfig.lib.json libs/component/tsconfig.lib.json --force --pretty false"
      },
      "cache": false
    },
    "typecheck-spec": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/demo-effect",
        "command": "tsc -p tsconfig.spec.json --noEmit --pretty false"
      },
      "inputs": [
        "{workspaceRoot}/tsconfig.base.json",
        "{projectRoot}/tsconfig.json",
        "{projectRoot}/tsconfig.spec.json",
        "{projectRoot}/src/**/*.ts",
        "{projectRoot}/src/**/*.d.ts"
      ],
      "cache": true
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/demo-effect"],
      "options": {
        "command": "npx vite build --config apps/demo-effect/vite.config.ts"
      },
      "configurations": {
        "production": {
          "command": "npx vite build --config apps/demo-effect/vite.config.ts --mode production"
        },
        "development": {
          "command": "npx vite build --config apps/demo-effect/vite.config.ts --mode development"
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "continuous": true,
      "executor": "nx:run-commands",
      "dependsOn": ["build-local-types"],
      "options": {
        "commands": [
          {
            "command": "npx vite --config apps/demo-effect/vite.config.ts",
            "forwardAllArgs": true
          },
          {
            "command": "node tools/demo-typecheck.mjs --project=demo-effect --non-blocking",
            "forwardAllArgs": false
          }
        ],
        "parallel": true
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/run-lib-vitest.mjs apps/demo-effect/vitest.config.ts",
        "forwardAllArgs": true
      }
    },
    "architecture": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx vitest run --config vitest.architecture.config.ts",
        "cwd": "apps/demo-effect"
      },
      "inputs": [
        "{projectRoot}/src/**/*.ts",
        "{projectRoot}/architecture/**/*.ts",
        "{projectRoot}/tsconfig.graph.json",
        "{projectRoot}/tsconfig.architecture.json"
      ],
      "cache": true
    },
    "review-generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx nx run demo-effect:architecture && npx tsx libs/dev-tools/src/bin/craft.ts organize --project apps/demo-effect/tsconfig.graph.json --graph craft-dependency-graph.json --out apps/demo-effect/folder-layout && (npx tsx libs/cli/src/bin/craft-ts.ts attest status --config apps/demo-effect/review-attest.config.ts --kind all --tsconfig apps/demo-effect/tsconfig.graph.json || test $? -eq 1)",
        "cwd": "{workspaceRoot}"
      }
    },
    "review": {
      "continuous": true,
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsx libs/cli/src/bin/craft-ts.ts attest devtools --config apps/demo-effect/review-attest.config.ts --tsconfig apps/demo-effect/tsconfig.graph.json",
        "cwd": "{workspaceRoot}"
      }
    },
    "typecheck-architecture": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/demo-effect",
        "command": "tsc -p tsconfig.architecture.json --noEmit --pretty false"
      },
      "inputs": [
        "{projectRoot}/tsconfig.json",
        "{projectRoot}/tsconfig.architecture.json",
        "{projectRoot}/architecture/**/*.ts"
      ],
      "cache": true
    }
  }
}
