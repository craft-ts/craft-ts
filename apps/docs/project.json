{
  "name": "docs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "vitepress dev apps/docs"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config apps/docs/vitest.config.mts"
      }
    },
    "typecheck-architecture-docs": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p apps/docs/tsconfig.architecture-docs.json --noEmit --pretty false"
      },
      "inputs": [
        "{workspaceRoot}/tsconfig.base.json",
        "{projectRoot}/tsconfig.architecture-docs.json",
        "{projectRoot}/tests/snippets/guide/testing/architecture/**/*.ts"
      ]
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{options.outputPath}"],
      "options": {
        "command": "vitepress build apps/docs"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "maxWarnings": -1
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "vitepress dev apps/docs"
      }
    }
  },
  "tags": []
}
