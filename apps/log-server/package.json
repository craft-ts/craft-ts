{
  "name": "@craft-ts/log-server",
  "version": "0.9.3",
  "description": "Local JSONL log ingestion server for CraftTS development",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "!dist/**/*.spec.js",
    "!dist/**/*.spec.d.ts",
    "!dist/**/*.spec.js.map"
  ],
  "bin": {
    "craft-ts-log-server": "dist/main.js"
  },
  "scripts": {
    "build": "npm run build --workspace @craft-ts/session-trace && tsc -p tsconfig.json",
    "start": "npm run build && node dist/main.js",
    "test": "vitest run --config vitest.config.mts"
  },
  "devDependencies": {
    "@types/node": "20.19.9",
    "@types/ws": "^8.18.1",
    "typescript": "6.0.3",
    "vitest": "^4.0.8"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@craft-ts/session-trace": "^0.9.3",
    "ws": "^8.21.3"
  }
}
