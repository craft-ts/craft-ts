    "test": "vitest run --config vitest.config.mts"
  },
  "devDependencies": {
    "@types/node": "20.19.9",
    "typescript": "6.0.3",
    "vitest": "^4.0.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
